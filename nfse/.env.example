# Copie para .env e preencha. Nunca versione o .env.

# Nome do produto (aparece no site, e-mails e sistema)
APP_NAME=EmitAI
# Endereço público, com https:// em produção
APP_URL=https://app.seudominio.com.br
NODE_ENV=production

# Senha do PostgreSQL usado pelo docker-compose
POSTGRES_PASSWORD=troque-esta-senha
# (fora do docker-compose, informe a URL completa)
# DATABASE_URL=postgres://usuario:senha@host:5432/nfse

# Chave mestra que protege os certificados A1 dos clientes.
# Gere com: openssl rand -base64 32
# GUARDE EM LOCAL SEGURO: sem ela, os certificados gravados não podem ser lidos.
NFSE_MASTER_KEY=

# E-mails de quem administra a plataforma (separados por vírgula)
SUPERADMIN_EMAILS=voce@seudominio.com.br

# Envio de e-mails (confirmação, convites, redefinição de senha)
SMTP_URL=smtps://usuario:senha@smtp.seuprovedor.com:465
EMAIL_FROM=nao-responda@seudominio.com.br
# Contato exibido para suporte e para quem não puder pagar online
SUPPORT_EMAIL=contato@seudominio.com.br

# Cobrança pelo Asaas (assinatura mensal por Pix, boleto ou cartão)
# Chave em: Asaas > Integrações > Chave de API. Comece pelo sandbox.
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
# Token que você define ao cadastrar o webhook no Asaas (Integrações > Webhooks).
# URL do webhook: https://SEU-DOMINIO/api/v1/cobranca/asaas
ASAAS_WEBHOOK_TOKEN=
# Dias de atraso antes de suspender a emissão
DIAS_TOLERANCIA=5

# Dias de teste grátis para novas contas
TRIAL_DAYS=14
# Quantos proxies existem na frente da aplicação (para o IP real do cliente)
TRUST_PROXY=1

# Integra Contador (SERPRO). Prefira configurar pela tela Administração → Integra Contador.
# Estas variáveis são alternativa para quem prefere deixar no servidor.
# INTEGRA_AMBIENTE=trial
# INTEGRA_CONSUMER_KEY=
# INTEGRA_CONSUMER_SECRET=
# INTEGRA_CONTRATANTE_CNPJ=
# INTEGRA_CONTRATANTE_NOME=
# INTEGRA_CERT_PATH=/caminho/para/ecnpj.pfx
# INTEGRA_CERT_SENHA=
